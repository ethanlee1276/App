# Copy this file to  secrets.local  and paste your key(s) in.
#
#     cp secrets.local.example secrets.local
#
# secrets.local is gitignored — it stays on your machine and is never
# committed or pushed. The app reads it automatically; no export needed.
#
# Two keys, both free, and the app runs fine with neither. Everything
# else — MLB scores, weather, lineups, NFL and CFB schedules, live scores,
# UFC fighter data — needs no key at all.

# Free key from https://the-odds-api.com
# Real sportsbook lines. Without it nothing is ever recommended, because
# nothing is recommended against a made-up price.
ODDS_API_KEY=

# Free app registration at https://developer.yahoo.com — ONLY needed if you
# play in a Yahoo fantasy league. Any app name, permission "Fantasy Sports
# read". These two identify the APP, not you: on their own they cannot read
# anybody's league, because a human still has to approve it on Yahoo's own
# screen. That approval is what this app stores, and you can revoke it from
# your Yahoo account page at any time. No password is ever shared.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Stripe, for subscriptions. ONLY needed once the site starts charging —
# everything works without these, and the billing card simply says so.
#
# STRIPE, AFTER ALL. Stripe declined the category on 2026-08-15, Paddle
# turned out not to serve this business model at all, and the account was
# then approved on appeal with the correct categorisation
# (docs/STRIPE_APPLICATION.md is what was filed). engine/paddle.py is
# still in the tree and is NOT wired to anything — see its header.
#
# Card numbers never touch this server: customers type them on Stripe's
# own Checkout page. Do not build a card form.
#
# USE THE TEST KEY (sk_test_...) UNTIL THE WHOLE FLOW WORKS. Test and live
# are the same Stripe account distinguished by the key prefix, so the
# switch is this one line and nothing else moves. Card 4242 4242 4242 4242
# with any future expiry walks the whole flow without money existing.
# Values are left blank because this file is TRACKED IN GIT and every
# value in it must be empty — that rule is what stops a real key being
# committed by someone who edited the template instead of the copy.
STRIPE_SECRET_KEY=

# The three plans. `python3 launch.py --stripe-setup` creates them in
# Stripe and prints these three lines with the real ids to paste — do not
# transcribe them from the dashboard by hand. A swapped pair of ids does
# not fail; it charges the wrong amount to somebody who chose the other
# plan.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SIXMONTH=
STRIPE_PRICE_YEARLY=

# The WEBHOOK signing secret (whsec_...), not the API key — different
# strings, different lifetimes, and only this one belongs in a signature
# check. It does not exist until the endpoint does, so this is the LAST
# thing filled in. Without it the webhook endpoint REFUSES every event
# rather than trusting it: an unsigned webhook that is accepted is a free
# subscription for whoever finds the URL. And because the webhook is the
# only thing that grants access, refusing every event means paying
# customers never get in — so this being blank is not a quiet state.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends the customer back after paying. Optional: left blank,
# the return trip uses whatever hostname the customer's browser used.
# Set it when the site answers on more than one name, so nobody is
# returned to a bare IP or a hostname with no certificate on it.
# Include the scheme, no trailing slash: https://qellysbook.com
QB_SITE_URL=

# The members' Discord. An invite link (https://discord.gg/xxxxxxxx).
#
# NOT IN THE CODE, on purpose. web/js/app.js is a static asset served to
# every anonymous visitor, so an invite compiled into it is public no
# matter what the page renders. The server sends this only in the answer
# to somebody it has already decided is entitled.
#
# Leaving it blank simply hides the Discord panel — nothing breaks.
# Rotating it after a leak is this line and a restart, with no deploy.
QB_DISCORD_INVITE=

# THE PAYWALL SWITCH. Empty means off, and off is how this ships: the
# boards are published whole and the site behaves exactly as it did before
# any of the gating existed. Set to 1 only once Paddle is live, because
# switching it on with no processor configured locks EVERY account out of
# the picks — including yours.
QB_PAYWALL=

# Accounts entitled without paying, comma-separated. Your own address
# belongs here before the switch above is ever set to 1, or the first
# thing the paywall does is lock you out of your own board. Also how you
# comp a tester or honour a refund without going through the processor.
# Read from this file and never from the database, so nothing reachable
# from the web can grant it.
QB_COMP_EMAILS=

# Free key from https://collegefootballdata.com/key
# The college RECRUITING layer: composites, blue-chip ratio, returning
# production, the transfer portal. It matters most in September, when a
# team's own results are two games against opponents nobody has measured
# either. Without it the CFB model is results-only and says so.
CFBD_API_KEY=
