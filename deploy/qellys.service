# Qellys Book — the app process.
#
#   sudo cp deploy/qellys.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qellys
#   systemctl status qellys
#   journalctl -u qellys -f
#
# Runs as an unprivileged user. If the app is ever compromised, what it
# can reach is what this user can reach — which is why it is not root and
# why the hardening below is not decoration.

[Unit]
Description=Qellys Book
After=network-online.target
Wants=network-online.target

# THESE TWO LIVE IN [Unit], NOT [Service], and they were in the wrong
# section until 2026-08-16. systemd does not fail on a misplaced key — it
# logs "Unknown key name 'StartLimitIntervalSec' in section 'Service',
# ignoring" once at load and carries on, so the protection reads as
# present in the file and is absent in reality.
#
# It mattered the first time the service was under stress: the droplet's
# OOM killer took the process during its first cold build, and with the
# limit ignored `Restart=always` would have gone round for ever, burning
# CPU and filling the journal instead of stopping and showing a failed
# unit. Give up after 5 restarts in 60s, so a genuine crash is VISIBLE in
# `systemctl status` rather than hidden behind an infinite retry.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=qellys
Group=qellys
WorkingDirectory=/srv/qellys

# WHY launch.py AND NOT server.py. This ran `server.py` first, which
# serves the site perfectly and rebuilds nothing: `web/data/*.json` would
# have frozen at whatever the deploy wrote, and a public board still
# labelled "live" showing a month-old slate is worse than one that is
# honestly down. launch.py is the process with the refresh loop in it —
# ~60s page rebuilds, the faster UFC and meme clocks, the nightly ingest
# and the auto-settle — and it serves the identical handler, because it
# does `from server import Handler`. Same site, plus the thing that keeps
# it true. server.py stays the way to run the site by hand.
#
# --bind 127.0.0.1 is the important half. Caddy is the only thing that
# should be able to reach this port; bound to 0.0.0.0 the plain-HTTP port
# is reachable from outside too and the TLS in front becomes optional
# for an attacker. (launch.py only grew this flag for this unit — before
# that it always bound every interface, which is fine on a laptop and
# exactly wrong on a public box.)
#
# The launcher always serves built JSON rather than running the pipeline
# per request, so the `--live` that server.py needs is implied here.
#
# AUTO-UPDATE IS NOT ON THIS LINE ANY MORE, AND THAT IS THE FIX.
# `--auto-update` was added here on 2026-08-31 and failed silently every
# five minutes for an hour while three pushed fixes sat unpulled: this
# service runs as the unprivileged `qellys` user under
# ProtectSystem=strict, so the checkout — .git and every source file —
# is READ-ONLY to it, and the deploy key lives in root's home behind
# ProtectHome=true. An in-process pull could never have worked here, and
# the sandbox is right: a public web process must not be able to rewrite
# its own code. Pushed code now goes live via qellys-update.timer — a
# root oneshot (deploy/autoupdate.py) that pulls --ff-only and restarts
# this unit only when the code actually moved, recording every attempt
# in data/autoupdate.json for `launch.py --boards` to read. Same cadence,
# same guards, and the failures are visible this time.
#
# The flag itself still exists in launch.py for a laptop someone sits
# at; it just has no business inside this sandbox.
ExecStart=/usr/bin/python3 /srv/qellys/launch.py --bind 127.0.0.1 8000

Restart=always
RestartSec=3

# A 1GB droplet cannot cold-build every board without help: measured on
# 2026-08-16, the first start on a fresh clone was killed by the OOM
# killer after seven minutes of CPU. The fix is a swapfile (deploy/README
# says how) — this is the seatbelt for when that is not enough.
#
# Without a limit the kernel picks the victim when memory runs out, and
# it may well pick something else on the box. Naming ourselves means the
# app is what dies, systemd restarts it, and the journal says which unit
# rather than leaving a mystery reboot. The value must fit the BOX:
# 900M was right for the original 1GB droplet and was left behind when
# the droplet was resized to 2GB — and a cap can hurt without ever
# killing anything. Measured 2026-08-17: the cgroup sat at 826M of 900M
# mid-build, so the kernel reclaimed instead of killing — every page the
# MLB build touched went straight to swap, the build thrashed at a crawl
# for three hours without finishing OR logging, and the board froze at
# its last successful write. No OOM line, no traceback, no signal:
# silence is what a limit that only throttles looks like. 1600M on a 2GB
# box leaves the system and Caddy their room; raise it with the droplet.
MemoryMax=1600M
MemoryAccounting=true
# THE CLOCK THE SLATES LIVE ON. Every "today" in the pipeline is the
# machine's local date, and a stock droplet runs UTC — so from 8pm
# Eastern onward its evening rebuilds label TONIGHT'S slate with
# tomorrow's date. The settle path grew a whole neighbour-day fallback
# to grade around exactly that drift ("thirty home-run bets dated 07-27
# whose players are all logged on 07-26"); this line removes the drift
# at the source instead of catching it downstream. After editing:
#   sudo cp deploy/qellys.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart qellys
Environment=TZ=America/New_York

# Secrets come from a file root owns and this user can only read.
# Never put them on the ExecStart line: /proc makes command lines
# readable by every account on the box.
EnvironmentFile=-/etc/qellys/env

# --- hardening ------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only writable paths: the databases, the caches, and the built JSON.
ReadWritePaths=/srv/qellys/data /srv/qellys/web/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Outbound HTTPS to the data feeds and Stripe; nothing exotic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
