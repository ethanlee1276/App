# Qellys Book — the public front door.
#
# Caddy rather than nginx for one reason: it gets and renews the TLS
# certificate itself, with no certbot and no cron job to forget. The
# commonest way a small site goes down is an expired certificate nobody
# was watching.
#
#   sudo apt install caddy
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The app must be started with `--bind 127.0.0.1` (see qellys.service).
# Binding all interfaces would leave the plain-HTTP port reachable from
# outside as well, and a proxy you can walk around protects nothing.

# BOTH NAMES, and the bare one is the canonical site. Caddy issues a
# certificate for each. The www redirect is at the bottom of this file:
# serving the same content on two hostnames splits sessions (a cookie set
# on one is not sent to the other, so signing in at www and then visiting
# the bare name looks like being signed out) and gives search engines two
# copies of everything.
qellysbook.com {
	encode gzip zstd

	# --- the API: proxied to the app ---------------------------------
	# X-Forwarded-* is what lets the app see the REAL caller. Without it
	# every request looks like it came from 127.0.0.1, which would make
	# `_local_only()` true for the entire internet — and that guard is
	# what stops strangers creating profiles and posting passwords over
	# cleartext. Caddy sets these by default; they are written out here
	# so nobody "tidies them away" later.
	#
	# "Unnecessary header_up …" — Caddy logs that warning for all three on
	# every reload. Leave them. It is quoted here so that grepping the
	# warning lands on the reason rather than on nothing.
	# The warning is about forwarding, and the point here is REPLACING:
	# `{remote_host}` overwrites the header, so the list the app reads has
	# exactly one entry — the peer Caddy actually saw. The default appends
	# instead, leaving whatever the client claimed in front of it.
	# `_client_ip()` reads the last entry and is safe either way; with the
	# overwrite it is also safe under first-entry parsing, which is the
	# refactor most likely to happen by accident.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
		}
	}

	# --- everything else: files straight off disk --------------------
	# Python is not in the path for static files at all. The app is a
	# stdlib http.server; Caddy serves assets far better and it keeps the
	# single-threaded-ish app for the work only it can do.
	handle {
		root * /srv/qellys/web
		try_files {path} /index.html
		file_server
	}

	# The app sets its own security headers on every response. These
	# cover the static files Caddy serves directly, which never pass
	# through it. HSTS is Caddy's job — it knows TLS is really on.
	#
	# THE CSP HAS TO BE HERE TOO, and its absence was a real hole. Look at
	# the handle block above: index.html is served by `file_server`
	# straight off disk, so the app never sees that request and the CSP it
	# sets never reaches the document. The policy would have applied to
	# /api/* JSON — where it does almost nothing — and not to the one
	# response that actually executes scripts. In production the page
	# would have had no CSP at all, and nothing would have looked wrong.
	#
	# Duplicated from server.py's SECURITY_HEADERS, which is a real cost:
	# two copies drift. tests/test_public_server.py compares them
	# character for character so they cannot.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-src https://dexscreener.com https://www.dexscreener.com https://geckoterminal.com https://www.geckoterminal.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# THE SERVICE WORKER MUST NOT BE CACHED. It is the one file that can
	# make every other file stale: a worker cached for a year keeps
	# serving its own old shell, and the fix — shipping a new worker —
	# is the exact thing the cache prevents from arriving. `no-cache`
	# means revalidate every time, not "never store".
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# THE SHELL REVALIDATES, ALWAYS. index.html, app.js and styles.css
	# carried no Cache-Control at all, which hands the decision to
	# browser heuristics — and iOS used them: after the 2026-08-17 nav
	# deploy, a phone kept its old app.js (heuristically "fresh") under
	# the freshly-fetched index.html. The Library group ships folded in
	# the markup and only the new JS can unfold it, so the button was
	# dead and six pages unreachable. `no-cache` means store but
	# REVALIDATE: one conditional request, a 304 when nothing changed,
	# and a deploy is live on the next open instead of whenever a
	# heuristic expires. The document is matched at / and /index.html —
	# the app routes with the hash fragment, which never reaches the
	# server, so / IS the document for every view.
	@shell path / /index.html /js/* /css/*
	header @shell Cache-Control "no-cache"

	# Caddy's built-in MIME table does not know .webmanifest, so without
	# this it goes out as text/plain and the install prompt silently never
	# appears — no error, no console message, just no prompt.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Built JSON changes on a schedule, not per request. A minute of
	# cache takes the repeat-visit load off the box without anyone ever
	# seeing a board more than a minute stale.
	@built path /data/*.json
	header @built Cache-Control "public, max-age=60"

	log {
		output file /var/log/caddy/qellys.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# One canonical hostname. Anyone who types www gets moved to the bare
# name before anything is served, so a session cookie only ever exists on
# one origin. 308 rather than 302: it is permanent and it preserves the
# method, so a POST that arrives at www is not silently turned into a GET.
www.qellysbook.com {
	redir https://qellysbook.com{uri} permanent
}

