{
  "appId": "com.qellysbook.app",
  "appName": "Qellys Book",
  "webDir": "www",
  "server": {
    "url": "https://qellysbook.com/?app=ios",
    "allowNavigation": [
      "qellysbook.com"
    ]
  },
  "appendUserAgent": "QellysApp/1.0 (ios)",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0C0B0A"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "backgroundColor": "#0C0B0A",
      "launchAutoHide": true
    }
  }
}
